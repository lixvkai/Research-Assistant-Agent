# Copy this file to `.env` and fill in your own keys.
# DeepSeek 兼容 OpenAI SDK，因此 base_url 直接走 DeepSeek 官方网关即可。

DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ── Agent 行为 ────────────────────────────────────────────────
MAX_REACT_STEPS=10
MAX_REFLECTIONS=1
# 每次反思修订额外追加的步数配额（与工具循环预算互不侵占）
REFLECTION_STEP_BONUS=2
LLM_TIMEOUT=60.0
LLM_MAX_RETRIES=3

# 上下文窗口高低水位（单位：消息条数，不是对话轮数）
# 超过 CONTEXT_TRIM_TRIGGER 才裁剪，一裁就裁到 MAX_CONTEXT_MESSAGES，
# 中间的差值是缓冲区：两者相等会导致窗口贴着阈值，每轮都要调 LLM 重做摘要。
MAX_CONTEXT_MESSAGES=25
CONTEXT_TRIM_TRIGGER=40

# ── 全局运行预算（防止 多Agent×ReAct 嵌套导致成本失控）──────
MAX_LLM_CALLS_PER_RUN=60
RUN_DEADLINE_SECONDS=600

# ── 并行度 ────────────────────────────────────────────────────
TOOL_MAX_WORKERS=4
ORCHESTRATOR_MAX_WORKERS=3

# ── 记忆系统 ──────────────────────────────────────────────────
# 开启后长期记忆走向量召回（复用 RAG 嵌入模型）；关闭则用内置分词打分检索
MEMORY_SEMANTIC_SEARCH=false
MEMORY_DEDUP_THRESHOLD=0.92

# ── 存储路径（可选，默认在 data/ 下）─────────────────────────
# CHROMA_PERSIST_DIR=
# PAPERS_DIR=
# MEMORY_DB_PATH=

# ── 日志 ──────────────────────────────────────────────────────
# DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# ── Gradio：默认仅本机访问。若改为 0.0.0.0，请务必配置下方鉴权。──
GRADIO_SERVER_NAME=127.0.0.1
GRADIO_SERVER_PORT=7860
# GRADIO_AUTH_USERNAME=admin
# GRADIO_AUTH_PASSWORD=change-me

# ── FastAPI 服务（uvicorn api.main:app）──────────────────────
API_HOST=127.0.0.1
API_PORT=8000
# 启动时预加载 Agent 与工具，避免首个请求延迟数秒
API_WARMUP=true
# 允许跨域的前端来源，逗号分隔；留空则不启用 CORS
# API_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
